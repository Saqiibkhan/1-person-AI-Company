# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM Provider (Section 14) ---
# "openrouter" or "ollama"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_key_here
MODEL_NAME=openai/gpt-4o-mini
OLLAMA_MODEL=llama3

# --- Database ---
# Default: local SQLite file, zero setup required.
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/ai_company
DATABASE_URL=sqlite:///./ai_company.db

# --- Revision control (Section 6): QA content rejections ---
MAX_REVISIONS=2

# --- Technical retry control: transient failures (network errors,
# unparseable LLM responses) get retried this many times automatically
# before a task is marked FAILED. Separate from MAX_REVISIONS above.
MAX_TASK_RETRIES=2

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
